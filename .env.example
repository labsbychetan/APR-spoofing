# Cyber Telemetry Lab - Environment Configuration Template
# For Vercel or local deployment

# Port configuration (default 3000)
PORT=3000

# Rate limit window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum telemetry submissions per IP in the window (default: 30)
RATE_LIMIT_MAX_REQUESTS=30

# Maximum in-memory event retention count (default: 200)
MAX_STORED_EVENTS=200

# Educational mode flag
NEXT_PUBLIC_DEMO_MODE=true
